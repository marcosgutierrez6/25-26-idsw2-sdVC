@startuml
title Diagrama de Secuencia - Eliminar Respuesta (NestJS + Vue 3)

actor "Usuario (Docente)" as User
participant "PreguntasForm\n(Modal)" as ParentForm
participant "RespuestasView\n(Listado)" as List
participant "RespuestasController" as Controller
participant "RespuestasService" as Service
participant "PrismaService" as Prisma
participant "Base de Datos\n(SQLite/PostgreSQL)" as DB

User -> ParentForm: Hace clic en "Eliminar"\nsobre una respuesta
activate ParentForm

ParentForm -> List: Muestra diálogo de\nconfirmación
activate List

List --> User: Muestra diálogo de\nconfirmación

User -> List: Confirma eliminación
List -> Controller: DELETE /api/respuestas/:id
activate Controller

Controller -> Service: remove(id)
activate Service

Service -> Prisma: respuesta.findUnique({ where: { id } })
activate Prisma
Prisma -> DB: SELECT Respuesta WHERE id=?
activate DB
DB --> Prisma: respuesta | null
deactivate DB
Prisma --> Service: respuesta
deactivate Prisma

alt Respuesta no encontrada
  Service --> Controller: throw NotFoundException
  Controller --> List: 404 Not Found
  List --> User: Muestra "Respuesta\nno encontrada"
else Respuesta existe
  Service -> Prisma: respuesta.delete({ where: { id } })
  activate Prisma
  Prisma -> DB: DELETE FROM Respuesta WHERE id=?
  activate DB
  DB --> Prisma: respuesta eliminada
  deactivate DB
  Prisma --> Service: respuesta eliminada
  deactivate Prisma

  Service --> Controller: respuesta eliminada
  deactivate Service
  Controller --> List: 200 OK\n{ respuesta }
  deactivate Controller
  List --> ParentForm: Notifica\neleminación exitosa
  deactivate List
  ParentForm --> User: Muestra éxito y\nrecarga listado
end

deactivate ParentForm

@enduml
