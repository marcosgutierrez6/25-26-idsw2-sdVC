@startuml
title Diagrama de Secuencia - Ver Respuestas (NestJS + Vue 3)

actor "Usuario (Docente)" as User
participant "PreguntasForm\n(Formulario con tabs)" as ParentForm
participant "RespuestasView\n(Listado)" as List
participant "RespuestasController" as Controller
participant "RespuestasService" as Service
participant "PrismaService" as Prisma
participant "Base de Datos\n(SQLite/PostgreSQL)" as DB

note over ParentForm : Modo edición: [Datos] [Respuestas] (activo)\ntodos los tabs activos

User -> ParentForm: Cambia al tab\n[Respuestas]
activate ParentForm

ParentForm -> List: Muestra listado\nde respuestas
activate List

List -> Controller: GET /api/respuestas/pregunta/:preguntaId
activate Controller

Controller -> Service: findByPregunta(preguntaId)
activate Service

Service -> Prisma: respuesta.findMany({ where: { preguntaId } })
activate Prisma
Prisma -> DB: SELECT Respuesta WHERE preguntaId=?
activate DB
DB --> Prisma: respuestas[]
deactivate DB
Prisma --> Service: respuestas[]
deactivate Prisma

Service --> Controller: respuestas[]
deactivate Service
Controller --> List: 200 OK\nrespuestas[]
deactivate Controller

List --> ParentForm: Devuelve listado\nde respuestas
deactivate List
ParentForm --> User: Muestra listado de\nrespuestas de la pregunta
deactivate ParentForm

@enduml
