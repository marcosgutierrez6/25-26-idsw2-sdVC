@startuml
title Diagrama de Secuencia - Importar Asignaturas (NestJS + Vue 3)

actor "Usuario (Docente)" as User
participant "AsignaturasView" as FE
participant "AsignaturasController" as Controller
participant "AsignaturasService" as Service
participant "PrismaService" as Prisma
participant "Base de Datos\n(SQLite/PostgreSQL)" as DB

User -> FE: Navega a "Importar\nAsignaturas"
activate FE
FE --> User: Muestra formulario\ncarga de archivo CSV

User -> FE: Selecciona archivo\ncon datos de asignaturas
FE -> FE: Lee y previsualiza\nnúmero de registros
FE --> User: Muestra resumen\ny solicita confirmación

User -> FE: Confirma importación
FE -> Controller: POST /api/asignaturas/importar\nbody: { asignaturas: [...] }
activate Controller
Controller -> Service: importarAsignaturas(asignaturas)
activate Service

Service -> Service: Valida sintaxis\nde cada registro

alt Datos inválidos
  Service --> Controller: lanza BadRequestException
  Controller --> FE: 400 Bad Request
  FE --> User: Muestra errores\nde validación
else Datos válidos
  Service -> Prisma: asignatura.createMany({ data, skipDuplicates: true })
  activate Prisma
  Prisma -> DB: INSERT INTO Asignatura (batch)
  activate DB
  DB --> Prisma: asignaturas creadas
  deactivate DB
  Prisma --> Service: resultado
  deactivate Prisma

  Service --> Controller: { importados, omitidos, errores }
end

deactivate Service
Controller --> FE: 201 Created\n{ resumen importación }
deactivate Controller
FE --> User: Muestra resultado
FE -> FE: Recarga listado
deactivate FE

@enduml
