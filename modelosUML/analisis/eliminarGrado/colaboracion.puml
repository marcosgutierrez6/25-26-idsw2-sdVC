@startuml colaboracion-eliminarGrado
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11

actor "Docente" as a
boundary "EliminarGradoView" as v
control "GradosController" as c
entity "GradosService" as s
entity "Grado" as e

a -> v : 1: solicita eliminar\ngrado
v -> c : 2: findOne(id)
c -> s : 3: findOne(id)
s -> e : 3.1: consulta\ngrado con\nrelaciones
e --> s : datos\ncompletos
s --> c : grado con\nrelaciones
c --> v : { grado }
v --> a : 4: presenta info\ny advertencia

a -> v : 5: confirma\neliminación
v -> c : 6: remove(id)
c -> s : 7: remove(id)
s -> e : 7.1: verifica\nexistencia\ny elimina
e --> s : ok
s --> c : grado\neliminado
c --> v : ok
v --> a : 8: vuelve a\nlistado\nactualizado

note right of c
  GET /grados/:id
  DELETE /grados/:id
end note

@enduml
