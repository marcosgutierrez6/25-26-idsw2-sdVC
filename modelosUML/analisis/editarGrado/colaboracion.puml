@startuml colaboracion-editarGrado
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11

actor "Docente" as a
boundary "EditarGradoView" as v
control "GradosController" as c
entity "GradosService" as s
entity "Grado" as e

a -> v : 1: solicita editar\ngrado existente
v -> c : 2: findOne(id)
c -> s : 3: findOne(id)
s -> e : 3.1: consulta datos\ndel grado
e --> s : datos del\ngrado
s --> c : grado con\nalumnos
c --> v : { grado,\nalumnos }
v --> a : 4: presenta formulario\ncon datos precargados

a -> v : 5: modifica campos\ny pulsa\n"Guardar cambios"
v -> c : 6: update(id,\nupdateGradoDto)
c -> s : 7: update(id, data)
s -> e : 7.1: actualiza\natributos
e --> s : grado\nactualizado
s --> c : grado\nactualizado
c --> v : { grado\nactualizado }
v --> a : 8: muestra resultado\ny navega a\nGRADO_ABIERTO2

note right of c
  Valida DTO y
  verifica existencia
  antes de actualizar
end note

@enduml
