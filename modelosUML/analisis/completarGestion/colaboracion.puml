@startuml colaboracion-completarGestion
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11

actor "Docente /\nAdmin.\ninstitucional" as a
boundary "DashboardView" as v
entity "AuthStore" as st

a -> v : 1: solicita\nSISTEMA_DISPONIBLE
v -> st : 2: obtiene rol\ny opciones
st --> v : { rol,\nopciones }
v --> a : 3: presenta\nmenú según\nrol
a -> v : 4: selecciona\nopción
v --> a : 5: navega a\nfuncionalidad\nespecífica

note right of v
  Menú Docente:
  • Grados
  • Asignaturas
  • Alumnos
  • Preguntas
  • Generar exámenes
  • Corregir exámenes
  • Importar/Exportar
  • Cerrar sesión

  Menú Admin:
  • Docentes
  • Cerrar sesión
end note

@enduml
